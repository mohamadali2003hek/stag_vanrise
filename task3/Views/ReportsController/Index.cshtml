@model List<task3.Models.PhoneNumberStatusReport>

@{
    ViewData["Title"] = "Phone Number Status Report";
}

<h2>Phone Number Status Report</h2>

<form asp-controller="Reports"
      asp-action="PhoneNumberStatus"
      method="get">

    <div class="mb-3">
        <label for="deviceID" class="form-label">Device</label>

        <select id="deviceID"
                name="deviceID"
                class="form-select">
            <option value="">All Devices</option>

            @foreach (var device in ViewBag.Devices)
            {
                if (ViewBag.SelectedDeviceID != null &&
                    (int)ViewBag.SelectedDeviceID == device.Id)
                {
                    <option value="@device.Id" selected>
                        @device.Name
                    </option>
                }
                else
                {
                    <option value="@device.Id">
                        @device.Name
                    </option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="phoneNumberStatus" class="form-label">
            Phone Number Status
        </label>

        <select id="phoneNumberStatus"
                name="phoneNumberStatus"
                class="form-select">

            <option value="">All Statuses</option>

            @if (ViewBag.SelectedStatus == "Reserved")
            {
                <option value="Reserved" selected>Reserved</option>
            }
            else
            {
                <option value="Reserved">Reserved</option>
            }

            @if (ViewBag.SelectedStatus == "Unreserved")
            {
                <option value="Unreserved" selected>Unreserved</option>
            }
            else
            {
                <option value="Unreserved">Unreserved</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Filter
    </button>

    <a asp-controller="Reports"
       asp-action="PhoneNumberStatus"
       class="btn btn-secondary">
        Reset
    </a>
</form>

<table class="table table-bordered table-striped mt-4">
    <thead>
        <tr>
            <th>Device</th>
            <th>Phone Numbers Status</th>
            <th># of Phone Numbers</th>
        </tr>
    </thead>

    <tbody>
        @if (Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Device</td>
                    <td>@item.PhoneNumbersStatus</td>
                    <td>@item.NumberOfPhoneNumbers</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">
                    No results found.
                </td>
            </tr>
        }
    </tbody>
</table>
